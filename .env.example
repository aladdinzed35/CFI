# ════════════════════════════════════════════════════════════════════════════
# CFI — environment reference
# Copy to `.env` for local development. Every value below is validated by
# src/lib/env.ts at boot: a missing or malformed required value crashes the
# process immediately rather than failing later in a request.
# Where each production value comes from → docs/DEPLOYMENT.md
# ════════════════════════════════════════════════════════════════════════════

# ─── Core ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Canonical origin, no trailing slash.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database (MySQL 8) ─────────────────────────────────────────────────────
# Hostinger MySQL connection limits are low — do not raise connection_limit
# without checking the plan.
DATABASE_URL="mysql://root:password@localhost:3306/cfi?connection_limit=5&pool_timeout=20"

# ─── Auth ───────────────────────────────────────────────────────────────────
# openssl rand -base64 48
AUTH_SECRET=
AUTH_TRUST_HOST=true
SESSION_MAX_AGE_DAYS=30

# ─── Mail (Hostinger SMTP) ──────────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@cfi.ma
SMTP_PASSWORD=
MAIL_FROM_NAME="CFI — Centre de Formation Immersive"
MAIL_FROM_ADDRESS=no-reply@cfi.ma
# Comma-separated.
MAIL_ADMIN_RECIPIENTS=admin@cfi.ma

# ─── Storage (S3-compatible; Cloudflare R2 by default) ──────────────────────
# s3 | local  — `local` is development only and is not durable on Hostinger.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=cfi-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional CDN origin for public objects.
S3_PUBLIC_BASE_URL=
LOCAL_STORAGE_PATH=./.storage

# ─── Video (never served from the app host) ─────────────────────────────────
# bunny | cloudflare | vimeo | youtube
VIDEO_PROVIDER=bunny
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_TOKEN_AUTH_KEY=

# ─── AI — the assistant « Nour » ────────────────────────────────────────────
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL_CHAT=claude-haiku-4-5-20251001
AI_MODEL_REASONING=claude-sonnet-5
# voyage | local
EMBEDDINGS_PROVIDER=local
VOYAGE_API_KEY=
AI_DAILY_TOKEN_BUDGET_PER_USER=60000
AI_MONTHLY_COST_CAP_USD=150

# ─── Jobs / cron ────────────────────────────────────────────────────────────
# Long random secret; sent as ?key= or `Authorization: Bearer`.
CRON_SECRET=

# ─── Optional ───────────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_GA_ID=
MAINTENANCE_MODE=false
