# ════════════════════════════════════════════════════════════════════════════
# CFI — environment reference
# Copy to `.env` for local development. Every value below is validated by
# src/lib/env.ts at boot: a missing or malformed required value crashes the
# process immediately rather than failing later in a request.
# Where each production value comes from → docs/DEPLOYMENT.md
# ════════════════════════════════════════════════════════════════════════════

# ─── Core ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Canonical origin, no trailing slash.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database (MySQL 8) ─────────────────────────────────────────────────────
# Hostinger MySQL connection limits are low — do not raise connection_limit
# without checking the plan.
DATABASE_URL="mysql://root:password@localhost:3306/cfi?connection_limit=5&pool_timeout=20"

# ─── Auth ───────────────────────────────────────────────────────────────────
# openssl rand -base64 48
AUTH_SECRET=
AUTH_TRUST_HOST=true
SESSION_MAX_AGE_DAYS=30

# ─── Mail (Hostinger SMTP) ──────────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
# Leave unset in production. Set to false ONLY against a local SMTP sink such
# as Mailpit, which advertises STARTTLS without implementing it.
#SMTP_REQUIRE_TLS=
SMTP_USER=no-reply@cfi.ma
SMTP_PASSWORD=
MAIL_FROM_NAME="CFI — Centre de Formation Immersive"
MAIL_FROM_ADDRESS=no-reply@cfi.ma
# Comma-separated.
MAIL_ADMIN_RECIPIENTS=admin@cfi.ma

# ─── Storage (S3-compatible; Cloudflare R2 by default) ──────────────────────
# s3 | local  — `local` is development only and is not durable on Hostinger.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=cfi-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional CDN origin for public objects.
S3_PUBLIC_BASE_URL=
LOCAL_STORAGE_PATH=./.storage

# ─── Video (never served from the app host) ─────────────────────────────────
# bunny | cloudflare | vimeo | youtube
VIDEO_PROVIDER=bunny
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_TOKEN_AUTH_KEY=

# ─── AI — the assistant « Nour » ────────────────────────────────────────────
# Embeddings run LOCALLY, in-process: no key, no network, no per-call cost.
# Generation is optional — see docs/AI.md.
AI_ENABLED=false

# none | openai-compatible
#   none              curated answers + grounded retrieval, no generation at all.
#                     The assistant is genuinely useful in this mode.
#   openai-compatible any OpenAI-shaped endpoint. Ollama on a VPS:
#                     AI_BASE_URL=http://127.0.0.1:11434/v1 and no key.
#                     Groq / Together / OpenRouter: their URL + a key.
AI_PROVIDER=none
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_CHAT=qwen2.5:7b-instruct

# Changing the embedding model or dtype invalidates every stored vector and
# requires a full reindex. q8 is ~135 MB on disk; fp32 is ~4x that.
AI_EMBEDDING_MODEL=Xenova/multilingual-e5-small
AI_EMBEDDING_DTYPE=q8

AI_MAX_OUTPUT_TOKENS=800
AI_TIMEOUT_MS=30000
AI_DAILY_TOKEN_BUDGET_PER_USER=60000
AI_MONTHLY_COST_CAP_USD=150

# ─── Jobs / cron ────────────────────────────────────────────────────────────
# Long random secret; sent as ?key= or `Authorization: Bearer`.
CRON_SECRET=

# ─── Optional ───────────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_GA_ID=
MAINTENANCE_MODE=false
